# ─── PHØNIX AI — Environment configuration ───
# Copy to ".env" and fill in. In production JWT secrets are REQUIRED.

PORT=3001
NODE_ENV=development

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Access-token lifetime (e.g. 15m, 24h)
ACCESS_TTL=24h

# Comma-separated browser origins allowed to call the API
CLIENT_ORIGINS=http://localhost:3001

# Storage
DB_PATH=./phonix.db
UPLOAD_DIR=./uploads
